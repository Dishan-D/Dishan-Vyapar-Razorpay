# ─── Model provider (Stage 1 extraction, Stage 3 phrasing) ───────────────────
# Set ONE of these. Groq wins if both are present; LLM_PROVIDER forces a choice.
# With neither, the pipeline runs on fixtures and every stage below Stage 1 is
# unaffected — nothing here is required to run the project.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=groq          # groq | claude | none
# GROQ_MODEL=qwen/qwen3.8-27b   # must support vision + strict json_schema
# CLAUDE_MODEL=claude-opus-5

# ─── Razorpay (test mode only — a live key is refused at startup) ─────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ─── Signing keys (JWK JSON strings) ─────────────────────────────────────────
# If unset, a keypair set is generated once and kept in data/keys.local.json.
BUYER_AGENT_JWK=
MERCHANT_JWK=
PLATFORM_JWK=
