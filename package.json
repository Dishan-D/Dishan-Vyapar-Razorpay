{
  "name": "vyapar-to-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Makes UPI-only Indian merchants transactable by AI buyer-agents: auto-catalog, bounded negotiation, and a signed 4-mandate audit chain.",
  "scripts": {
    "milestone-a": "tsx --env-file-if-exists=.env scripts/milestone-a.ts",
    "typecheck": "tsc --noEmit",
    "milestone-b": "tsx --env-file-if-exists=.env scripts/milestone-b.ts",
    "milestone-c": "tsx --env-file-if-exists=.env scripts/milestone-c.ts",
    "milestone-d": "tsx --env-file-if-exists=.env scripts/milestone-d.ts",
    "milestone-e": "tsx --env-file-if-exists=.env scripts/milestone-e.ts",
    "serve": "tsx --env-file-if-exists=.env src/server.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "openai": "^6.49.0",
    "razorpay": "^2.9.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
